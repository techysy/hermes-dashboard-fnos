#!/bin/bash
# Hermes Agent — 空壳应用 + 目标仪表盘代理
# 通过配置目标 IP:端口, 由 proxy.py 把桌面 iframe (本机固定端口) 转发到目标 agent 仪表盘.
#
# 重启健壮性 (v1.2.5): NAS 重启后 pid 文件残留, 且 pid 号可能被无关进程复用.
# 旧版只用 kill -0 判活 → 误判"proxy 已在运行" → 开机自启被短路 →
# :9120 无监听 → 桌面窗口打不开 (连接被拒).
# 现在校验 /proc/<pid>/cmdline 确属本应用 proxy.py 后才认定在跑,
# 并在启动后轮询端口健康检查, 失败自动清理重试 (含残留进程占用端口的自愈).
set -u

APP_NAME="${TRIM_APPNAME:-HermesAgent}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
# 数据目录: 优先 TRIM_PKGVAR (fnOS 注入). 兜底: 从 fnOS home 软链 (/volX/@apphome/<app>) 推导卷,
# 或从 APP_DIR 推导; 不写死具体卷. (空壳应用 fnOS 可能不注入 TRIM_PKGVAR, 需此兜底)
APP_VOL=""
if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_DIR="${TRIM_PKGVAR}"
else
    # 从 home 软链推导卷 (fnOS 标准: /volX/@apphome/<app> -> /volX)
    if [ -L "${APP_DIR}/home" ]; then
        APP_HOME="$(readlink -f "${APP_DIR}/home")"
        APP_VOL="$(printf '%s' "${APP_HOME}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    # 兜底: 从 APP_DIR 推导卷
    if [ -z "${APP_VOL}" ]; then
        APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -n "${APP_VOL}" ]; then
        DATA_DIR="${APP_VOL}/@appdata/${APP_NAME}"
    else
        DATA_DIR="${APP_DIR}/var"
    fi
fi
# proxy 脚本与 cmd/main 同目录
CMD_DIR="$(cd "$(dirname "$0")" && pwd)"
PROXY_PY="${CMD_DIR}/proxy.py"
# 本机监听端口 (桌面 iframe 指向此端口)
LISTEN_PORT="${TRIM_SERVICE_PORT:-9120}"
PROXY_LOG="${DATA_DIR}/proxy.log"
PROXY_PID="${DATA_DIR}/proxy.pid"

# 目标配置 (默认 127.0.0.1:9119, 经设置页改)
CONF="${DATA_DIR}/dashboard.conf"

# Python 运行时 (manifest install_dep_apps=python312): 优先 fnOS 标准软链, fallback 应用卷/系统
PYTHON_BIN=""
for cand in /var/apps/python312/target/bin/python3 \
            /var/apps/python3/target/bin/python3 \
            "${APP_VOL}/@appcenter/python312/bin/python3" \
            "${APP_VOL}/@appcenter/python3/bin/python3" \
            /usr/bin/python3 /usr/local/bin/python3 /bin/python3; do
    [ -x "$cand" ] && PYTHON_BIN="$cand" && break
done
if [ -z "${PYTHON_BIN}" ]; then
    for name in python3 python3.13 python3.12 python3.11 python3.10 python3.9; do
        cand="$(command -v "$name" 2>/dev/null || true)"
        [ -n "$cand" ] && [ -x "$cand" ] && PYTHON_BIN="$cand" && break
    done
fi
[ -n "${PYTHON_BIN}" ] || PYTHON_BIN="python3"

mkdir -p "${DATA_DIR}"

read_target() {
    local ip port
    ip="127.0.0.1"; port="9119"
    if [ -f "${CONF}" ]; then
        local v
        v="$(grep -E '^TARGET_IP=' "${CONF}" | head -1 | cut -d= -f2- | tr -d '[:space:]')"
        [ -n "$v" ] && ip="$v"
        v="$(grep -E '^TARGET_PORT=' "${CONF}" | head -1 | cut -d= -f2- | tr -d '[:space:]')"
        [ -n "$v" ] && port="$v"
    fi
    echo "${ip} ${port}"
}

# ── 进程身份校验 ──
# pid_cmdline_has <pid> <pattern>: 进程存活且命令行含 pattern.
# 防 pid 复用误判 (重启后陈旧 pid 文件指向无关进程).
pid_cmdline_has() {
    local pid="$1" pat="$2"
    [ -n "${pid}" ] || return 1
    kill -0 "${pid}" 2>/dev/null || return 1
    if [ -r "/proc/${pid}/cmdline" ]; then
        tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -q -- "${pat}" && return 0
        return 1
    fi
    ps -p "${pid}" -o args= 2>/dev/null | grep -q -- "${pat}"
}

proxy_running() {
    [ -f "${PROXY_PID}" ] || return 1
    pid_cmdline_has "$(cat "${PROXY_PID}" 2>/dev/null)" "proxy.py"
}

# TCP 回环端口可连通 (0.0.0.0 监听时回环必可达)
port_alive() {
    bash -c "exec 3<>/dev/tcp/127.0.0.1/${LISTEN_PORT}" 2>/dev/null
}

proxy_healthy() {
    proxy_running && port_alive
}

launch_proxy() {
    HERMES_LISTEN_PORT="${LISTEN_PORT}" HERMES_CONF_DIR="${DATA_DIR}" \
        nohup "${PYTHON_BIN}" "${PROXY_PY}" >> "${PROXY_LOG}" 2>&1 &
    echo $! > "${PROXY_PID}"
}

kill_proxy() {
    if [ -f "${PROXY_PID}" ]; then
        # 只杀确认属于本应用的进程, 防 pid 复用误杀无关进程
        if pid_cmdline_has "$(cat "${PROXY_PID}" 2>/dev/null)" "proxy.py"; then
            kill "$(cat "${PROXY_PID}")" 2>/dev/null || true
        fi
        rm -f "${PROXY_PID}"
    fi
    # 清理 pid 文件丢失但仍在占用端口的残留 proxy (README 踩坑: Address already in use)
    pkill -f "${PROXY_PY}" 2>/dev/null || true
}

start() {
    # 陈旧 pid 文件清理: pid 存在但不是本应用 proxy (重启后 pid 被复用) → 删除重来
    if [ -f "${PROXY_PID}" ] && ! proxy_running; then
        echo "removing stale pid file (pid $(cat "${PROXY_PID}" 2>/dev/null) is not our proxy)"
        rm -f "${PROXY_PID}"
    fi

    if proxy_running; then
        # 进程在但端口不通 (僵尸态) → 杀掉重启自愈
        if proxy_healthy; then
            echo "proxy already running (pid $(cat "${PROXY_PID}"))"
            return 0
        fi
        echo "WARN: proxy alive but :${LISTEN_PORT} not reachable, restarting..."
        kill_proxy
        sleep 1
    fi

    # 确保数据目录存在 + 配置文件兜底 (缺省用本机默认, 避免读错/读不到配置)
    mkdir -p "${DATA_DIR}" 2>/dev/null || true
    if [ ! -f "${CONF}" ]; then
        printf 'TARGET_IP=127.0.0.1\nTARGET_PORT=9119\n' > "${CONF}" 2>/dev/null || true
        chmod 600 "${CONF}" 2>/dev/null || true
        echo "created default dashboard.conf (127.0.0.1:9119)"
    fi
    read -r t_ip t_port < <(read_target)
    # 校验 proxy.py 存在
    if [ ! -f "${PROXY_PY}" ]; then
        echo "ERROR: proxy.py not found at ${PROXY_PY}" >&2
        return 1
    fi

    # 启动 + 健康检查, 失败自动重试 (开机时卷/依赖应用尚未就绪的容错;
    # 端口被残留进程占用时 kill_proxy 的 pkill 会清掉, 下一轮即可绑定)
    # proxy.py 内部对端口绑定自带退避重试, 这里轮询等待而不是固定 sleep,
    # 避免误杀"正在退避重试绑定"的健康进程
    local attempt=1 max_attempt=3 waited
    while [ "${attempt}" -le "${max_attempt}" ]; do
        launch_proxy
        echo "proxy started (pid $(cat "${PROXY_PID}")) listen :${LISTEN_PORT} -> ${t_ip}:${t_port} (python: ${PYTHON_BIN}) (attempt ${attempt}/${max_attempt})"
        waited=0
        while [ "${waited}" -lt 20 ]; do
            sleep 1
            waited=$((waited + 1))
            if ! proxy_running; then
                break   # 进程已退出 (如端口绑定最终失败), 立即重试
            fi
            if port_alive; then
                echo "proxy health OK (:${LISTEN_PORT}, ${waited}s)"
                return 0
            fi
        done
        echo "WARN: proxy health check failed after ${waited}s (attempt ${attempt}/${max_attempt}), retrying..." >&2
        kill_proxy
        attempt=$((attempt + 1))
        [ "${attempt}" -le "${max_attempt}" ] && sleep $((attempt * 2))
    done

    echo "ERROR: proxy failed to start after ${max_attempt} attempts (check ${PROXY_LOG})" >&2
    return 1
}

stop() {
    kill_proxy
    echo "proxy stopped"
}

status() {
    if proxy_running; then
        read -r t_ip t_port < <(read_target)
        if port_alive; then
            echo "running (pid $(cat "${PROXY_PID}")) listen :${LISTEN_PORT} -> ${t_ip}:${t_port}"
            return 0
        fi
        echo "degraded (pid $(cat "${PROXY_PID}") alive but :${LISTEN_PORT} not listening)"
        return 1
    fi
    echo "stopped"
    return 1
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
exit 0
