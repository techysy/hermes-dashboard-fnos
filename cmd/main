#!/bin/bash
# Hermes Agent — 空壳应用 + 目标仪表盘代理
# 通过配置目标 IP:端口, 由 proxy.py 把桌面 iframe (本机固定端口) 转发到目标 agent 仪表盘.
set -u

APP_NAME="${TRIM_APPNAME:-HermesAgent}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
# 数据目录: 优先 TRIM_PKGVAR (fnOS 注入). 兜底: 从 fnOS home 软链 (/volX/@apphome/<app>) 推导卷,
# 或从 APP_DIR 推导; 不写死具体卷. (空壳应用 fnOS 可能不注入 TRIM_PKGVAR, 需此兜底)
APP_VOL=""
if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_DIR="${TRIM_PKGVAR}"
else
    # 从 home 软链推导卷 (fnOS 标准: /volX/@apphome/<app> -> /volX)
    if [ -L "${APP_DIR}/home" ]; then
        APP_HOME="$(readlink -f "${APP_DIR}/home")"
        APP_VOL="$(printf '%s' "${APP_HOME}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    # 兜底: 从 APP_DIR 推导卷
    if [ -z "${APP_VOL}" ]; then
        APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
    fi
    if [ -n "${APP_VOL}" ]; then
        DATA_DIR="${APP_VOL}/@appdata/${APP_NAME}"
    else
        DATA_DIR="${APP_DIR}/var"
    fi
fi
# proxy 脚本与 cmd/main 同目录
CMD_DIR="$(cd "$(dirname "$0")" && pwd)"
PROXY_PY="${CMD_DIR}/proxy.py"
# 本机监听端口 (桌面 iframe 指向此端口)
LISTEN_PORT="${TRIM_SERVICE_PORT:-9120}"
PROXY_LOG="${DATA_DIR}/proxy.log"
PROXY_PID="${DATA_DIR}/proxy.pid"

# 目标配置 (默认 127.0.0.1:9119, 经设置页改)
CONF="${DATA_DIR}/dashboard.conf"

# Python 运行时 (manifest install_dep_apps=python312): 优先 fnOS 标准软链, fallback 应用卷/系统
PYTHON_BIN=""
for cand in /var/apps/python312/target/bin/python3 "${APP_VOL}/@appcenter/python312/bin/python3" /usr/bin/python3; do
    [ -x "$cand" ] && PYTHON_BIN="$cand" && break
done
[ -n "${PYTHON_BIN}" ] || PYTHON_BIN="python3"

mkdir -p "${DATA_DIR}"

read_target() {
    local ip port
    ip="127.0.0.1"; port="9119"
    if [ -f "${CONF}" ]; then
        local v
        v="$(grep -E '^TARGET_IP=' "${CONF}" | head -1 | cut -d= -f2- | tr -d '[:space:]')"
        [ -n "$v" ] && ip="$v"
        v="$(grep -E '^TARGET_PORT=' "${CONF}" | head -1 | cut -d= -f2- | tr -d '[:space:]')"
        [ -n "$v" ] && port="$v"
    fi
    echo "${ip} ${port}"
}

start() {
    if [ -f "${PROXY_PID}" ] && kill -0 "$(cat "${PROXY_PID}")" 2>/dev/null; then
        echo "proxy already running (pid $(cat "${PROXY_PID}"))"
        return 0
    fi
    # 确保数据目录存在 + 配置文件兜底 (缺省用本机默认, 避免读错/读不到配置)
    mkdir -p "${DATA_DIR}" 2>/dev/null || true
    if [ ! -f "${CONF}" ]; then
        printf 'TARGET_IP=127.0.0.1\nTARGET_PORT=9119\n' > "${CONF}" 2>/dev/null || true
        echo "created default dashboard.conf (127.0.0.1:9119)" 
    fi
    read -r t_ip t_port < <(read_target)
    # 校验 proxy.py 存在
    if [ ! -f "${PROXY_PY}" ]; then
        echo "ERROR: proxy.py not found at ${PROXY_PY}" >&2
        return 1
    fi
    HERMES_LISTEN_PORT="${LISTEN_PORT}" HERMES_CONF_DIR="${DATA_DIR}" \
        nohup "${PYTHON_BIN}" "${PROXY_PY}" >> "${PROXY_LOG}" 2>&1 &
    echo $! > "${PROXY_PID}"
    echo "proxy started (pid $(cat "${PROXY_PID}")) listen :${LISTEN_PORT} -> ${t_ip}:${t_port} (python: ${PYTHON_BIN})"
    sleep 2
    # 健康检查: 进程存活 + 端口监听
    if ! kill -0 "$(cat "${PROXY_PID}")" 2>/dev/null; then
        echo "ERROR: proxy failed to start (check proxy.log)" >&2
        rm -f "${PROXY_PID}"
        return 1
    fi
    # 校验端口监听 (proxy 可能绑定失败)
    if ! (command -v ss >/dev/null 2>&1 && ss -tln 2>/dev/null | grep -q ":${LISTEN_PORT} ") && \
       ! (command -v netstat >/dev/null 2>&1 && netstat -tln 2>/dev/null | grep -q ":${LISTEN_PORT} "); then
        echo "ERROR: proxy not listening on :${LISTEN_PORT}" >&2
        return 1
    fi
    echo "proxy health OK (:${LISTEN_PORT})"
    return 0
}

stop() {
    if [ -f "${PROXY_PID}" ]; then
        kill "$(cat "${PROXY_PID}")" 2>/dev/null || true
        rm -f "${PROXY_PID}"
    fi
    pkill -f "${PROXY_PY}" 2>/dev/null || true
    echo "proxy stopped"
}

status() {
    if [ -f "${PROXY_PID}" ] && kill -0 "$(cat "${PROXY_PID}")" 2>/dev/null; then
        read -r t_ip t_port < <(read_target)
        echo "running (pid $(cat "${PROXY_PID}")) listen :${LISTEN_PORT} -> ${t_ip}:${t_port}"
        return 0
    fi
    echo "stopped"
    return 1
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|status|restart}"; exit 1 ;;
esac
exit 0
