#!/bin/bash
# install_callback — 保存安装向导填的目标仪表盘 IP + 端口
# 安装时运行. 字段为 wizard_ 前缀 (如 wizard_target_ip). 留空用默认 127.0.0.1:9119.
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-HermesAgent}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
# 数据目录: 优先 TRIM_PKGVAR (fnOS 注入); 兜底从 APP_DIR 提取卷推导, 不写死 /vol4
APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
DATA_DIR="${TRIM_PKGVAR:-${APP_VOL}/@appdata/${APP_NAME}}"
LOG="${DATA_DIR}/install.log"
CONF="${DATA_DIR}/dashboard.conf"

mkdir -p "${DATA_DIR}" 2>/dev/null
echo "[$(date '+%F %T')] install_callback start target_ip='${wizard_target_ip:-}' target_port='${wizard_target_port:-}'" >> "${LOG}"

# 目标 IP: 默认 127.0.0.1; 端口: 默认 9119
ip="${wizard_target_ip:-127.0.0.1}"
port="${wizard_target_port:-9119}"
printf 'TARGET_IP=%s\nTARGET_PORT=%s\n' "${ip}" "${port}" > "${CONF}" 2>/dev/null
chmod 600 "${CONF}" 2>/dev/null
chown "${APP_NAME:-HermesAgent}:${APP_NAME:-HermesAgent}" "${CONF}" 2>/dev/null || true
echo "[$(date '+%F %T')] saved dashboard.conf: ${ip}:${port}" >> "${LOG}"

echo "[$(date '+%F %T')] install_callback done" >> "${LOG}"
exit 0
