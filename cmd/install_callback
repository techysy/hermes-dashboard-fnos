#!/bin/bash
# install_callback — 保存安装向导填的目标仪表盘 IP + 端口
# 安装时运行. 字段为 wizard_ 前缀 (如 wizard_target_ip). 留空用默认 127.0.0.1:9119.
set -uo pipefail

APP_NAME="${TRIM_APPNAME:-HermesAgent}"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
# 数据目录: 优先 TRIM_PKGVAR (fnOS 注入); 兜底从 APP_DIR 提取卷推导, 不写死 /vol4
APP_VOL="$(printf '%s' "${APP_DIR}" | sed -n 's#^\(/vol[^/]*\)/.*#\1#p')"
DATA_DIR="${TRIM_PKGVAR:-${APP_VOL}/@appdata/${APP_NAME}}"
LOG="${DATA_DIR}/install.log"
CONF="${DATA_DIR}/dashboard.conf"

mkdir -p "${DATA_DIR}" 2>/dev/null
echo "[$(date '+%F %T')] install_callback start target_ip='${wizard_target_ip:-}' target_port='${wizard_target_port:-}'" >> "${LOG}"

# 目标 IP: 默认 127.0.0.1; 端口: 默认 9119
ip="${wizard_target_ip:-}"
port="${wizard_target_port:-}"
# 若安装向导未填 IP (升级场景会复用 install_callback 但 wizard_target_ip 为空),
# 且已有 dashboard.conf, 则保留当前配置, 不覆盖为用户之前设好的目标.
if [ -n "${ip}" ]; then
    [ -z "${port}" ] && port="9119"
    printf 'TARGET_IP=%s\nTARGET_PORT=%s\n' "${ip}" "${port}" > "${CONF}" 2>/dev/null
    chmod 600 "${CONF}" 2>/dev/null
    chown "${APP_NAME:-HermesAgent}:${APP_NAME:-HermesAgent}" "${CONF}" 2>/dev/null || true
    echo "[$(date '+%F %T')] saved dashboard.conf: ${ip}:${port}" >> "${LOG}"
elif [ -f "${CONF}" ]; then
    echo "[$(date '+%F %T')] wizard_target_ip empty, keep existing dashboard.conf" >> "${LOG}"
else
    # 全新安装且未填: 用默认
    printf 'TARGET_IP=127.0.0.1\nTARGET_PORT=9119\n' > "${CONF}" 2>/dev/null
    chmod 600 "${CONF}" 2>/dev/null
    echo "[$(date '+%F %T')] saved default dashboard.conf: 127.0.0.1:9119" >> "${LOG}"
fi

echo "[$(date '+%F %T')] install_callback done" >> "${LOG}"

# 启动 proxy (fnOS App Center 对代理应用自动 start 有时不生效, 这里主动拉起, 保证装完即用)
# cmd/main 实际位于 /var/apps/<app>/cmd/main (fnOS 把脚本放 /var/apps, APP_DIR 可能指向 @appcenter)
MAIN_SCRIPT=""
for cand in "/var/apps/${APP_NAME}/cmd/main" "${APP_DIR}/cmd/main" "${APP_DIR}/target/cmd/main"; do
    [ -f "$cand" ] && MAIN_SCRIPT="$cand" && break
done
# 延迟后台启动, 避免阻塞 install 流程
(
    sleep 2
    if [ -n "${MAIN_SCRIPT}" ]; then
        bash "${MAIN_SCRIPT}" start >> "${LOG}" 2>&1
    else
        echo "[$(date '+%F %T')] ERROR: cmd/main not found" >> "${LOG}"
    fi
) &
echo "[$(date '+%F %T')] proxy start triggered (main=${MAIN_SCRIPT})" >> "${LOG}"
exit 0
